{
  "accounts": {
    "claude": ["anthropic", "anthropic-2", "anthropic-3"]
  },
  "tiers": {
    "default": {
      "description": "Build or fix from a known plan, spec, issue, or reproduction; deploys, merges, rollouts, and other production changes; anything that does not clearly fit another tier.",
      "chain": [
        "claude/claude-sonnet-5-5:high",
        "claude/claude-opus-5-5:low",
        "openai-codex/gpt-6.1-sol:xhigh",
        "xai/grok-4.7:high",
        "openai-codex/gpt-6-astra:low",
        "baseten/deepseek-ai/DeepSeek-V4.1-Flash-1017:high"
      ]
    },
    "deep": {
      "description": "Plan, research, investigate, root-cause, evaluate, or design when there is no verified plan yet; open-ended analysis, evals, and data investigation.",
      "chain": [
        "claude/claude-opus-5-5:xhigh",
        "claude/claude-fable-5-1:high",
        "claude/claude-sonnet-5-5:xhigh",
        "xai/grok-4.7:high",
        "openai-codex/gpt-6-astra:high",
        "baseten/deepseek-ai/DeepSeek-V4.1-Flash-1017:high"
      ]
    },
    "visual": {
      "description": "Work whose acceptance depends on visual quality or visual judgment: UI and UX, layout, styling, landing pages, motion graphics, ads, video, or other creative media.",
      "chain": [
        "claude/claude-opus-5-5:xhigh",
        "openai-codex/gpt-6-astra:high",
        "baseten/deepseek-ai/DeepSeek-V4.1-Flash-1017:high"
      ]
    },
    "watch": {
      "description": "Observe and report only, making no changes: monitoring after a merge or deploy, watching live calls or traffic for a period, read-only production checks. If the task itself merges, deploys, rolls out, or changes anything, it is not watch.",
      "chain": [
        "claude/claude-haiku-5-5:medium",
        "openai-codex/gpt-6-luna:max",
        "claude/claude-sonnet-5:low",
        "baseten/deepseek-ai/DeepSeek-V4.1-Flash-1017:high"
      ]
    },
    "quick": {
      "description": "Small bounded chores with an obvious path: docs, config, renames, small cosmetic edits, simple cleanups.",
      "chain": [
        "claude/claude-haiku-5-5:max",
        "claude/claude-sonnet-5-5:medium",
        "openai-codex/gpt-6.1-sol:low",
        "openai-codex/gpt-6-luna:max",
        "baseten/deepseek-ai/DeepSeek-V4.1-Flash-1017:high"
      ]
    },
    "orchestrator": {
      "description": "Firstmate and second-mate supervisor sessions.",
      "chain": [
        "claude/claude-opus-5-5:medium",
        "openai-codex/gpt-6-astra:medium",
        "baseten/deepseek-ai/DeepSeek-V4.1-Flash-1017:high"
      ]
    },
    "supervisor": {
      "description": "Firstmate's supervision branch: routine wake handling.",
      "chain": [
        "claude/claude-haiku-5-5:medium",
        "openai-codex/gpt-6-luna:max",
        "claude/claude-sonnet-5-5:low",
        "baseten/deepseek-ai/DeepSeek-V4.1-Flash-1017:high"
      ]
    },
    "compact": {
      "description": "OptChat compactor.",
      "chain": [
        "claude/claude-haiku-5-5:medium",
        "openai-codex/gpt-6-luna:medium",
        "claude/claude-sonnet-5-5:medium",
        "baseten/deepseek-ai/DeepSeek-V4.1-Flash-1017:high"
      ]
    },
    "reviewer": {
      "description": "no-mistakes reviewer: a different lab than the Claude-heavy implementers.",
      "chain": [
        "openai-codex/gpt-6.1-sol:low",
        "openai-codex/gpt-6-astra:low",
        "claude/claude-opus-5-5:low",
        "claude/claude-sonnet-5-5:high",
        "baseten/deepseek-ai/DeepSeek-V4.1-Flash-1017:high"
      ]
    }
  },
  "auto": {
    "classifier": "typesafe/jev-latest",
    "tiers": ["default", "deep", "visual", "watch", "quick"],
    "fallback": "default",
    "minConfidence": 0.6,
    "sections": ["## Captain's intent", "## Firstmate spec"],
    "maxChars": 8000
  },
  "rules": [],
  "override": "^Model override:\\s*(\\S+)(?:\\s+(\\S+))?",
  "warnProviders": ["baseten"]
}
