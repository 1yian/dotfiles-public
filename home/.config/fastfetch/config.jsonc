{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "apple",
    "padding": { "top": 1, "left": 2, "right": 2 },
    "color": { "1": "cyan", "2": "white" }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan",
      "title": "white"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}@{host-name-colored}"
    },
    "separator",
    { "type": "os", "key": "os" },
    { "type": "host", "key": "hw" },
    { "type": "kernel", "key": "krn" },
    { "type": "uptime", "key": "up" },
    { "type": "packages", "key": "pkg" },
    { "type": "shell", "key": "sh" },
    { "type": "terminal", "key": "term" },
    { "type": "cpu", "key": "cpu" },
    { "type": "memory", "key": "mem" },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
